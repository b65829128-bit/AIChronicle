    <Compile Include="../../Core/MainThreadExecutor.cs" Link="MainThreadExecutor.cs" />
    <Compile Include="../../Systems/HistoryArchive.cs" Link="HistoryArchive.cs" />
    <Compile Include="../../Systems/HistoryMarkdown.cs" Link="HistoryMarkdown.cs" />
