<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>AIChronicle.Pure.Tests</AssemblyName>
    <RootNamespace>AIChronicle.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MainThreadStubs.cs" />
    <Compile Include="LlmTests.cs" />
    <Compile Include="IdentityStubs.cs" />
    <Compile Include="EncounterTests.cs" />
    <Compile Include="MeetingTests.cs" />
    <Compile Include="DuelTests.cs" />
    <Compile Include="DuelGameStubs.cs" />
    <Compile Include="ClanDepartureStubs.cs" />
    <Compile Include="ClanDepartureTests.cs" />
    <Compile Include="../../Systems/ClanDeparture.cs" Link="ClanDeparture.cs" />
    <Compile Include="../../Systems/MeetingClanActions.cs" Link="MeetingClanActions.cs" />
    <Compile Include="../../Systems/MeetingEscrow.cs" Link="MeetingEscrow.cs" />
    <Compile Include="../../Systems/MeetingAssets.cs" Link="MeetingAssets.cs" />
    <Compile Include="../../Systems/DuelStore.cs" Link="DuelStore.cs" />
    <Compile Include="../../Systems/DuelModels.cs" Link="DuelModels.cs" />
    <Compile Include="../../Systems/DuelEncounter.cs" Link="DuelEncounter.cs" />
    <Compile Include="../../Systems/DuelRewardMath.cs" Link="DuelRewardMath.cs" />
    <Compile Include="../../Systems/MeetingModels.cs" Link="MeetingModels.cs" />
    <Compile Include="../../Systems/MeetingNegotiation.cs" Link="MeetingNegotiation.cs" />
    <Compile Include="../../Systems/MeetingBatch.cs" Link="MeetingBatch.cs" />
    <!-- 只链接不依赖 TaleWorlds 的纯逻辑文件（MainThreadExecutor 用最小桩）：无需游戏 DLL 即可在 CI/Linux 跑。 -->
    <Compile Include="../../Core/MainThreadExecutor.cs" Link="MainThreadExecutor.cs" />
    <Compile Include="../../Systems/HistoryArchive.cs" Link="HistoryArchive.cs" />
    <Compile Include="../../Systems/HistoryMarkdown.cs" Link="HistoryMarkdown.cs" />
    <Compile Include="../../Systems/CuriaVoteMath.cs" Link="CuriaVoteMath.cs" />
    <Compile Include="../../Systems/TreatyModels.cs" Link="TreatyModels.cs" />
    <Compile Include="../../Systems/TreatyText.cs" Link="TreatyText.cs" />
    <Compile Include="../../Core/SafeFileIO.cs" Link="SafeFileIO.cs" />
    <Compile Include="../../Agents/DiaryStore.cs" Link="DiaryStore.cs" />
    <Compile Include="../../Systems/SilentDiaryText.cs" Link="SilentDiaryText.cs" />
    <Compile Include="../../Agents/ToolCatalog.cs" Link="ToolCatalog.cs" />
    <Compile Include="../../Agents/ContextBuilder.Identity.cs" Link="ContextBuilder.Identity.cs" />
    <Compile Include="../../Entities/IdentityFacts.cs" Link="IdentityFacts.cs" />
    <Compile Include="../../Core/LLM/*.cs" Link="LLM/%(Filename)%(Extension)" />
    <Compile Include="../../Systems/TokenBudget.cs" Link="TokenBudget.cs" />
    <Compile Include="../../Systems/EncounterDiagnostics.cs" Link="EncounterDiagnostics.cs" />
    <!-- 复用 .NET SDK 随附的 JSON 程序集，仅给测试进程；无需游戏 DLL 或新增 NuGet 包。 -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(MSBuildSDKsPath)/../Newtonsoft.Json.dll</HintPath>
    </Reference>
    <None Include="../../_Module/Prompts/tools.json" Link="Prompts/tools.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../_Module/Prompts/agent_tools.json" Link="Prompts/agent_tools.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../_Module/Prompts/meeting_rules.txt" Link="Prompts/meeting_rules.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../_Module/Prompts/Templates/context_template.txt" Link="Prompts/context_template.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
