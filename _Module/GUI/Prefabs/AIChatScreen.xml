<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
            Sprite="BlankWhiteSquare_9" Color="#000000AA">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="650" SuggestedHeight="500"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Sprite="BlankWhiteSquare_9" Color="#1E1E2EFF" DoNotAcceptEvents="true">
          <Children>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="42"
                    Sprite="BlankWhiteSquare_9" Color="#2A2A3AFF" DoNotAcceptEvents="true">
              <Children>
                <TextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            VerticalAlignment="Center" MarginLeft="15"
                            Text="@TitleText" Brush="FullScreenNotice.Title" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="28" SuggestedHeight="28"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              MarginRight="8"
                              Brush="SPChatlog.Checkbox.CombatLog"
                              Command.Click="ExecuteClose"
                              UpdateChildrenStates="true" />
              </Children>
            </Widget>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    MarginTop="42" MarginBottom="55" DoNotAcceptEvents="true">
              <Children>
                <ScrollablePanel Id="ScrollablePanel" WidthSizePolicy="StretchToParent"
                                 HeightSizePolicy="StretchToParent"
                                 AutoHideScrollBars="false"
                                 ClipRect="ClipRect" InnerPanel="ClipRect\MessageList"
                                 VerticalScrollbar="..\Scrollbar\VerticalScrollbar">
                  <Children>
                    <Widget Id="ClipRect" ClipContents="true"
                            WidthSizePolicy="StretchToParent"
                            HeightSizePolicy="StretchToParent"
                            MarginLeft="10" MarginRight="10" MarginTop="5" MarginBottom="5">
                      <Children>
                        <ListPanel Id="MessageList" DataSource="{Messages}"
                                   WidthSizePolicy="StretchToParent"
                                   HeightSizePolicy="CoverChildren"
                                   VerticalAlignment="Bottom"
                                   StackLayout.LayoutMethod="VerticalTopToBottom">
                          <ItemTemplate>
                            <Widget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="CoverChildren"
                                    MarginBottom="10">
                              <Children>
                                <TextWidget WidthSizePolicy="CoverChildren"
                                            HeightSizePolicy="CoverChildren"
                                            Text="@SenderText"
                                            Brush="ChatLog.TabText"
                                            Brush.FontColor="@Color"
                                            ClipContents="false" />
                                <TextWidget WidthSizePolicy="CoverChildren"
                                            HeightSizePolicy="CoverChildren"
                                            Text="@TimeText"
                                            MarginLeft="8"
                                            Brush="ChatLog.TabText"
                                            Brush.FontSize="12"
                                            ClipContents="false" />
                                <RichTextWidget WidthSizePolicy="StretchToParent"
                                                HeightSizePolicy="CoverChildren"
                                                Text="@ContentText"
                                                MarginTop="6"
                                                Brush="ChatLog.Text"
                                                ClipContents="false" />
                              </Children>
                            </Widget>
                          </ItemTemplate>
                        </ListPanel>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>

                <Widget Id="Scrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent"
                        SuggestedWidth="8" HorizontalAlignment="Right" DoNotAcceptEvents="true">
                  <Children>
                    <ScrollbarWidget Id="VerticalScrollbar" WidthSizePolicy="Fixed"
                                     HeightSizePolicy="StretchToParent"
                                     SuggestedWidth="8"
                                     AlignmentAxis="Vertical"
                                     Handle="VerticalScrollbarHandle"
                                     MaxValue="100" MinValue="0">
                      <Children>
                        <ImageWidget Id="VerticalScrollbarHandle" WidthSizePolicy="Fixed"
                                     HeightSizePolicy="Fixed"
                                     SuggestedWidth="8" SuggestedHeight="20"
                                     Brush="FaceGen.Scrollbar.Handle" />
                      </Children>
                    </ScrollbarWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>

            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed"
                    SuggestedHeight="50" VerticalAlignment="Bottom"
                    Sprite="BlankWhiteSquare_9" Color="#2A2A3AFF" DoNotAcceptEvents="true">
              <Children>
                <EditableTextWidget WidthSizePolicy="StretchToParent"
                                    HeightSizePolicy="Fixed"
                                    SuggestedHeight="35"
                                    MarginLeft="10" MarginRight="75" MarginTop="7"
                                    Text="@InputText"
                                    MaxLength="500"
                                    Brush="ChatLog.Text" />
                <ButtonWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                              SuggestedWidth="55" SuggestedHeight="35"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              MarginRight="10"
                              Brush="ButtonBrush2"
                              Command.Click="ExecuteSend"
                              UpdateChildrenStates="true"
                              DoNotPassEventsToChildren="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent"
                                HeightSizePolicy="StretchToParent"
                                Text="@SendButtonText"
                                Brush="OverlayPopup.ButtonText" />
                  </Children>
                </ButtonWidget>
              </Children>
            </Widget>

          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
