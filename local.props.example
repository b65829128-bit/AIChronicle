<Project>
  <PropertyGroup>
    <!-- 复制为 local.props 后改成你的 Bannerlord 安装根目录（Steam/Proton 的 Windows 客户端）。
         环境变量 BANNERLORD_GAME_DIR 优先于本文件。 -->
    <BANNERLORD_GAME_DIR Condition="'$(BANNERLORD_GAME_DIR)' == ''">/path/to/Mount &amp; Blade II Bannerlord</BANNERLORD_GAME_DIR>
  </PropertyGroup>
</Project>
